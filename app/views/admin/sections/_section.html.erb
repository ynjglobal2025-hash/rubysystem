<%
  status_color = {
    'in_progress' => '#ffc107',
    'completed'   => '#28a745',
    'pending'     => '#6c757d'
  }[section.status] || '#6c757d'

  status_label = {
    'in_progress' => '진행 중',
    'completed'   => '완료',
    'pending'     => '대기 중'
  }[section.status] || section.status
%>

<div style="background:white; border-radius:8px; padding:20px; display:flex; align-items:center; gap:16px; box-shadow:0 1px 3px rgba(0,0,0,.06);">
  <!-- 진행률 원형 -->
  <div style="flex-shrink:0; width:52px; height:52px; border-radius:50%; border:4px solid <%= status_color %>; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; color:<%= status_color %>;">
    <%= section.progress %>%
  </div>

  <!-- 정보 -->
  <div style="flex:1; min-width:0;">
    <div style="font-weight:600; font-size:16px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= section.title %></div>
    <% if section.description.present? %>
      <div style="color:#666; font-size:13px; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= section.description %></div>
    <% end %>
    <div style="margin-top:6px;">
      <span style="background:<%= status_color %>22; color:<%= status_color %>; font-size:11px; font-weight:600; padding:2px 8px; border-radius:20px;"><%= status_label %></span>
    </div>
  </div>

  <!-- 액션 버튼 -->
  <div style="display:flex; gap:8px; flex-shrink:0;">
    <%= link_to '보기', admin_section_path(section), style: 'font-size:13px; color:#1a1a2e; text-decoration:none; padding:6px 12px; border:1px solid #ddd; border-radius:4px;' %>
    <%= link_to '편집', edit_admin_section_path(section), style: 'font-size:13px; color:white; background:#1a1a2e; text-decoration:none; padding:6px 12px; border-radius:4px;' %>
  </div>
</div>
