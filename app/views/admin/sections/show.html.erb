<%
  status_color = {
    'in_progress' => '#ffc107',
    'completed'   => '#28a745',
    'pending'     => '#6c757d'
  }[@section.status] || '#6c757d'

  status_label = {
    'in_progress' => '진행 중',
    'completed'   => '완료',
    'pending'     => '대기 중'
  }[@section.status] || @section.status
%>

<div style="margin-bottom:16px;">
  <%= link_to '← 목록으로', admin_sections_path, style: 'color:#666; text-decoration:none; font-size:14px;' %>
</div>

<div style="background:white; border-radius:8px; padding:28px; box-shadow:0 1px 3px rgba(0,0,0,.06);">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px; margin-bottom:24px;">
    <h1 style="font-size:22px; font-weight:700;"><%= @section.title %></h1>
    <span style="background:<%= status_color %>22; color:<%= status_color %>; font-weight:600; padding:4px 12px; border-radius:20px; font-size:13px;"><%= status_label %></span>
  </div>

  <% if @section.description.present? %>
    <p style="color:#555; margin-bottom:20px; line-height:1.6;"><%= @section.description %></p>
  <% end %>

  <!-- 진행률 바 -->
  <div style="margin-bottom:24px;">
    <div style="display:flex; justify-content:space-between; font-size:13px; color:#666; margin-bottom:6px;">
      <span>진행률</span><span><%= @section.progress %>%</span>
    </div>
    <div style="background:#f0f0f0; border-radius:4px; height:8px;">
      <div style="background:<%= status_color %>; height:8px; border-radius:4px; width:<%= @section.progress %>%; transition:width .3s;"></div>
    </div>
  </div>

  <div style="font-size:12px; color:#999; margin-bottom:24px;">
    마지막 수정: <%= @section.updated_at.strftime('%Y-%m-%d %H:%M') %>
  </div>

  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <%= link_to '편집', edit_admin_section_path(@section), style: 'background:#1a1a2e; color:white; padding:8px 16px; border-radius:6px; text-decoration:none; font-size:14px;' %>
    <%= button_to '삭제', admin_section_path(@section), method: :delete,
        style: 'background:#dc3545; color:white; padding:8px 16px; border-radius:6px; border:none; cursor:pointer; font-size:14px;',
        data: { confirm: '정말 삭제하시겠습니까?' } %>
  </div>
</div>
