<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
  <h1 style="font-size:24px; font-weight:700;">섹션 관리</h1>
  <%= link_to '+ 새 섹션', new_admin_section_path, style: 'background:#1a1a2e; color:white; padding:8px 16px; border-radius:6px; text-decoration:none; font-size:14px;' %>
</div>

<!-- 요약 카드 -->
<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px;">
  <div style="background:white; border-radius:8px; padding:20px; border-left:4px solid #ffc107;">
    <div style="font-size:28px; font-weight:700;"><%= @in_progress_count %></div>
    <div style="color:#666; font-size:13px; margin-top:4px;">진행 중</div>
  </div>
  <div style="background:white; border-radius:8px; padding:20px; border-left:4px solid #28a745;">
    <div style="font-size:28px; font-weight:700;"><%= @completed_count %></div>
    <div style="color:#666; font-size:13px; margin-top:4px;">완료</div>
  </div>
  <div style="background:white; border-radius:8px; padding:20px; border-left:4px solid #6c757d;">
    <div style="font-size:28px; font-weight:700;"><%= @pending_count %></div>
    <div style="color:#666; font-size:13px; margin-top:4px;">대기 중</div>
  </div>
</div>

<!-- 섹션 목록 -->
<div style="display:grid; gap:12px;">
  <% @sections.each do |section| %>
    <%= render 'section', section: section %>
  <% end %>
</div>

<% if @sections.empty? %>
  <div style="text-align:center; padding:60px 20px; color:#999;">
    <p style="font-size:16px;">등록된 섹션이 없습니다.</p>
    <%= link_to '첫 섹션 만들기', new_admin_section_path, style: 'color:#1a1a2e; font-weight:600; margin-top:8px; display:inline-block;' %>
  </div>
<% end %>
