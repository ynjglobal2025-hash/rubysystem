<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ruby Admin</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f5f5; color: #333; }

      .navbar {
        background: #1a1a2e;
        color: white;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .navbar a { color: white; text-decoration: none; font-weight: 600; font-size: 18px; }
      .navbar-links a { color: rgba(255,255,255,.8); font-size: 14px; margin-left: 16px; font-weight: 400; }
      .navbar-links a:hover { color: white; }

      .container { max-width: 1100px; margin: 0 auto; padding: 24px 16px; }

      .flash-notice {
        background: #d4edda; color: #155724; border: 1px solid #c3e6cb;
        padding: 12px 16px; border-radius: 6px; margin-bottom: 20px;
      }

      /* 모바일 반응형 */
      @media (max-width: 600px) {
        .navbar { padding: 0 12px; }
        .navbar-links { display: none; }
        .container { padding: 16px 12px; }
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <%= link_to 'Ruby Admin', admin_sections_path %>
      <div class="navbar-links">
        <%= link_to '섹션 관리', admin_sections_path %>
        <%= link_to '새 섹션', new_admin_section_path %>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="flash-notice"><%= notice %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
