<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Ruby Admin</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f2f2f7;
        color: #1c1c1e;
        padding-bottom: 80px;
      }

      /* 상단 헤더 */
      .header {
        background: #1a1a2e;
        color: white;
        padding: 16px 20px 14px;
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .header-back {
        color: rgba(255,255,255,.8);
        text-decoration: none;
        font-size: 15px;
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .header h1 { font-size: 18px; font-weight: 700; flex: 1; }
      .header-subtitle { font-size: 12px; color: rgba(255,255,255,.6); margin-top: 2px; }

      /* 컨텐츠 영역 */
      .content { padding: 16px; }

      /* 요약 배지 */
      .summary-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 20px;
      }
      .summary-card {
        background: white;
        border-radius: 12px;
        padding: 14px 10px;
        text-align: center;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
      }
      .summary-card .num { font-size: 26px; font-weight: 700; }
      .summary-card .label { font-size: 11px; color: #888; margin-top: 2px; }

      /* 섹션 그룹 */
      .section-group { margin-bottom: 24px; }
      .group-title {
        font-size: 13px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 0 4px;
        margin-bottom: 8px;
      }

      /* 섹션 카드 */
      .section-card {
        background: white;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 10px;
        box-shadow: 0 1px 3px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: inherit;
        transition: opacity .15s;
      }
      .section-card:active { opacity: .7; }

      .progress-ring {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        border: 3px solid;
      }
      .section-info { flex: 1; min-width: 0; }
      .section-title {
        font-size: 15px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .section-desc {
        font-size: 13px;
        color: #888;
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .section-status {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 20px;
        margin-top: 6px;
        display: inline-block;
      }
      .chevron { color: #c7c7cc; font-size: 18px; flex-shrink: 0; }

      /* 동기화 시간 */
      .sync-info {
        text-align: center;
        font-size: 12px;
        color: #aaa;
        padding: 8px;
        margin-bottom: 16px;
      }

      /* 하단 네비게이션 */
      .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0; right: 0;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(10px);
        border-top: 1px solid #e5e5ea;
        display: flex;
        padding: 8px 0 20px;
      }
      .nav-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        text-decoration: none;
        color: #8e8e93;
        font-size: 10px;
        font-weight: 500;
        padding: 4px;
      }
      .nav-item.active { color: #1a1a2e; }
      .nav-icon { font-size: 22px; }

      /* 상세 페이지 */
      .detail-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        margin-bottom: 16px;
      }
      .detail-header {
        padding: 24px 20px 20px;
        border-bottom: 1px solid #f2f2f7;
      }
      .detail-status-badge {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        margin-bottom: 10px;
      }
      .detail-title { font-size: 22px; font-weight: 700; line-height: 1.3; }
      .detail-section { padding: 16px 20px; border-bottom: 1px solid #f2f2f7; }
      .detail-section:last-child { border-bottom: none; }
      .detail-label { font-size: 12px; color: #888; font-weight: 600; text-transform: uppercase; letter-spacing: .3px; margin-bottom: 6px; }
      .detail-value { font-size: 15px; color: #1c1c1e; }

      .progress-bar-wrap { margin-top: 8px; }
      .progress-bar-bg { background: #f2f2f7; border-radius: 8px; height: 10px; overflow: hidden; }
      .progress-bar-fill { height: 10px; border-radius: 8px; transition: width .5s ease; }

      .meta-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: #888;
        padding: 4px 0;
      }
    </style>
  </head>
  <body>
    <%= yield %>

    <nav class="bottom-nav">
      <%= link_to mobile_root_path, class: "nav-item #{controller_action_name.include?('index') ? 'active' : ''}" do %>
        <span class="nav-icon">📋</span>
        <span>섹션 목록</span>
      <% end %>
      <%= link_to admin_sections_path, class: 'nav-item' do %>
        <span class="nav-icon">⚙️</span>
        <span>관리자</span>
      <% end %>
    </nav>
  </body>
</html>
